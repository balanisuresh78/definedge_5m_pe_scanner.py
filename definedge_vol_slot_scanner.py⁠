def send_volume_email(slot_title, matches, total_harvested):
    now_str = datetime.now(IST).strftime("%d-%b %H:%M:%S")
    subject = f"📊 Volume Breakout [{slot_title}] ({len(matches)} Matches) - ({now_str})"

    sorted_matches = sorted(matches, key=lambda x: x["vol_ratio"], reverse=True)

    top5_str = ", ".join([m["stock"] for m in sorted_matches[:5]]) or "None"
    all_str = ", ".join([m["stock"] for m in sorted_matches]) or "None"

    body_lines = [
        f"Intraday Volume Breakout Alert — Slot: {slot_title} (Checked at {now_str})",
        f"Daily Harvest Filter: -1 Close < -2 Close & Body < 0.67 * ATR(100) (Harvested Today: {total_harvested} stocks)\n",
        f"📋 TOP 5 BY VOLUME RATIO (Copy & Paste into Zone):\n{top5_str}\n",
        f"All Matches ({len(sorted_matches)}): {all_str}\n"
    ]

    if slot_title == "09:15-09:30 (All Five 3m Slots > 100d Avg)":
        headers = [
            "Stock", "Avg Vol Ratio", "S1(9:15)", "S2(9:18)", "S3(9:21)",
            "S4(9:24)", "S5(9:27)", "-1 Close", "ATR(100)", "Body"
        ]
        rows = [
            [
                m["stock"], f"{m['vol_ratio']}x",
                f"{m['s1_ratio']}x", f"{m['s2_ratio']}x", f"{m['s3_ratio']}x",
                f"{m['s4_ratio']}x", f"{m['s5_ratio']}x",
                m["m1_close"], m["atr100"], m["m1_body"]
            ]
            for m in sorted_matches
        ]
    else:
        headers = [
            "Stock", "30m Slot", "Vol Ratio", "Slot Vol", "100d Avg Vol",
            "-1 Close", "ATR(100)", "Body", "ATR/Body"
        ]
        rows = [
            [
                m["stock"], slot_title, f"{m['vol_ratio']}x",
                f"{int(m['slot_vol']):,}", f"{int(m['avg_vol']):,}",
                m["m1_close"], m["atr100"], m["m1_body"], m["body_atr_ratio"]
            ]
            for m in sorted_matches
        ]

    body_lines.append(tabulate(rows, headers=headers, tablefmt="grid"))

    msg = MIMEMultipart()
    msg["From"] = SENDER_EMAIL
    msg["To"] = RECEIVER_EMAIL
    msg["Subject"] = subject
    msg.attach(MIMEText("\n".join(body_lines), "plain"))

    with smtplib.SMTP_SSL("smtp.gmail.com", 465, timeout=30) as server:
        server.login(SENDER_EMAIL, APP_PASSWORD)
        server.send_message(msg)

    print(f"✅ Volume Alert Email sent for [{slot_title}] ({len(sorted_matches)} matches)!")

