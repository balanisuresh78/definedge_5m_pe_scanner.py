# 6. INTRADAY CHECKER: FIRST FIVE 3M SLOTS (09:30) + 30M SLOTS (10:00 - 15:30)
# ==============================================================================
def run_volume_scanner():
    now_ist = datetime.now(IST)
    conn, ic = login_definedge()

    valid_symbols = get_watchlist_symbols(conn)
    exch = conn.EXCHANGE_TYPE_NSE if SCAN_SEGMENT == "NSE" else conn.EXCHANGE_TYPE_NFO

    cache_data = load_or_build_today_cache(conn, ic, valid_symbols, now_ist)
    harvested = cache_data.get("stocks", {})
    sent_slots = set(cache_data.get("sent_slots", []))

    if not harvested:
        print("📭 No stocks qualified in today's harvest list.")
        return

    if now_ist.time() < dtime(9, 30):
        print(f"⏳ Harvest cache ready ({len(harvested)} stocks). Waiting for 09:30 AM IST to evaluate the five 3m slots...")
        return

    today_start = now_ist.replace(hour=9, minute=15, second=0, microsecond=0)

    today_1m_map = {}
    for symbol, info in harvested.items():
        try:
            df_today = fetch_df(conn, ic, exch, info["trading_symbol"], conn.TIMEFRAME_TYPE_MIN, today_start, now_ist)
            if not df_today.empty:
                df_today = df_today[df_today.index.date == now_ist.date()]
                today_1m_map[symbol] = df_today
        except Exception as e:
            print(f"⚠️ Error fetching today 1m for {symbol}: {e}")

    # PHASE 1: At/After 09:30 AM -> Check First Five 3-Minute Slots (09:15-09:30)
    slot_key_15m = "5x3M_09:15-09:30"
    if now_ist.time() >= dtime(9, 30) and slot_key_15m not in sent_slots:
        print("\n🔎 Evaluating First Five 3-Minute Volume Slots (09:15 to 09:30)...")
        matches_3m = []

        for symbol, info in harvested.items():
            df_today = today_1m_map.get(symbol)
            if df_today is None or df_today.empty:
                continue

            slot_ratios = []
            all_five_passed = True

            for label, start_t, end_t in SLOTS_3M:
                sub = df_today.between_time(start_t, end_t)
                today_vol = float(sub["volume"].sum()) if not sub.empty else 0.0
                avg_vol = float(info["avg_3m"].get(label, 0.0))

                if avg_vol <= 0 or today_vol <= avg_vol:
                    all_five_passed = False
                    break

                slot_ratios.append(round(today_vol / avg_vol, 2))

            if all_five_passed and len(slot_ratios) == 5:
                avg_ratio = round(float(np.mean(slot_ratios)), 2)
                matches_3m.append({
                    **info,
                    "s1_ratio": slot_ratios[0],
                    "s2_ratio": slot_ratios[1],
                    "s3_ratio": slot_ratios[2],
                    "s4_ratio": slot_ratios[3],
                    "s5_ratio": slot_ratios[4],
                    "vol_ratio": avg_ratio
                })
                print(f"  🔥 5x3m PASS: {symbol} | Slot Ratios: {slot_ratios} | Avg Vol Ratio: {avg_ratio}x")

        sent_slots.add(slot_key_15m)
        cache_data["sent_slots"] = sorted(list(sent_slots))
        save_today_cache(cache_data)

        if matches_3m:
            send_volume_email("09:15-09:30 (All Five 3m Slots > 100d Avg)", matches_3m, len(harvested))
        else:
            print("ℹ️ No harvested stocks beat their 100d average in all five 3-minute slots.")

    # PHASE 2: After 09:30 AM -> Check Each Completed 30-Minute Slot (09:30-15:30)
    for label, start_t, end_t, close_t in SLOTS_30M:
        if now_ist.time() >= close_t and label not in sent_slots:
            print(f"\n🔎 Evaluating 30-Minute Volume Slot [{label}]...")
            matches_30m = []

            for symbol, info in harvested.items():
                df_today = today_1m_map.get(symbol)
                if df_today is None or df_today.empty:
                    continue

                sub = df_today.between_time(start_t, end_t)
                today_vol = float(sub["volume"].sum()) if not sub.empty else 0.0
                avg_vol = float(info["avg_30m"].get(label, 0.0))

                if avg_vol > 0 and today_vol > avg_vol:
                    vol_ratio = round(today_vol / avg_vol, 2)
                    matches_30m.append({
                        **info,
                        "slot_vol": today_vol,
                        "avg_vol": avg_vol,
                        "vol_ratio": vol_ratio
                    })
                    print(f"  🔥 30m PASS [{label}]: {symbol} | Vol: {int(today_vol):,} > 100d Avg: {int(avg_vol):,} ({vol_ratio}x)")

            sent_slots.add(label)
            cache_data["sent_slots"] = sorted(list(sent_slots))
            save_today_cache(cache_data)

            if matches_30m:
                send_volume_email(label, matches_30m, len(harvested))
            else:
                print(f"ℹ️ No harvested stocks beat their 100d average volume on 30m slot [{label}].")

