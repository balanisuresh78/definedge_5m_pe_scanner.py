def parse_expiry_date(val):
    if pd.isna(val):
        return None
    s = str(val).strip()
    for fmt in ("%d%m%Y", "%Y-%m-%d", "%d-%b-%Y", "%d%b%Y", "%d-%m-%Y"):
        try:
            return datetime.strptime(s, fmt).date()
        except ValueError:
            continue
    return None

def get_watchlist_symbols(conn=None):
    today = datetime.now(IST).date()
    stock_set = set(fno_stocks)
    records = []

    url = "https://app.definedgesecurities.com/public/allmaster.zip"
    resp = requests.get(url, timeout=30)
    resp.raise_for_status()
    with zipfile.ZipFile(io.BytesIO(resp.content)) as z:
        csv_name = z.namelist()[0]
        with z.open(csv_name) as f:
            df = pd.read_csv(f, header=None, dtype=str, low_memory=False)

    if SCAN_SEGMENT == "NSE":
        eq = df[(df[0] == "NSE") & (df[4] == "EQ") & (df[2].str.strip().isin(stock_set))].copy()
        for _, row in eq.iterrows():
            records.append({
                "underlying": str(row[2]).strip(),
                "trading_symbol": str(row[3]).strip(),
                "exchange": conn.EXCHANGE_TYPE_NSE
            })
        return sorted(records, key=lambda x: x["underlying"])
    else:
        nfo = df[(df[0] == "NFO") & (df[4] == "FUTSTK") & (df[2].str.strip().isin(stock_set))].copy()
        for exp_col in [5, 8, 6, 7]:
            if exp_col in nfo.columns:
                parsed = pd.to_datetime(nfo[exp_col], format="%d%m%Y", errors="coerce")
                if parsed.notna().sum() > 0:
                    nfo["expiry"] = parsed.dt.date
                    break
        nfo = nfo[nfo["expiry"].notna() & (nfo["expiry"] >= today)]
        for _, row in nfo.iterrows():
            records.append({
                "underlying": str(row[2]).strip(),
                "trading_symbol": str(row[3]).strip(),
                "expiry": row["expiry"],
                "exchange": conn.EXCHANGE_TYPE_NFO
            })
        df_fut = pd.DataFrame(records)
        df_fut = df_fut.sort_values("expiry").groupby("underlying", as_index=False).first()
        return df_fut.sort_values("underlying").reset_index(drop=True).to_dict("records")

def fetch_df(conn, ic, exchange, trading_symbol, timeframe, start_dt, end_dt):
    hist = ic.historical_data(
        exchange=exchange,
        trading_symbol=trading_symbol,
        timeframe=timeframe,
        start=start_dt,
        end=end_dt
    )
    df = pd.DataFrame(list(hist))
    if df.empty:
        return pd.DataFrame()

    df["datetime"] = pd.to_datetime(df["datetime"])
    if df["datetime"].dt.tz is None:
        df["datetime"] = df["datetime"].dt.tz_localize(IST)
    else:
        df["datetime"] = df["datetime"].dt.tz_convert(IST)

    df = df.set_index("datetime").sort_index()
    for col in ["open", "high", "low", "close", "volume"]:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")
    return df

# ==============================================================================
# 4. DAILY HARVESTER (-1 Close < -2 Close & Body < 0.67 * ATR100)
#    + 100-DAY SLOT VOLUME BASELINE PRE-COMPUTATION
# ==============================================================================
def calculate_atr_sma(df, period=100):
    high = df["high"]
    low = df["low"]
    prev_close = df["close"].shift(1)
    tr = pd.concat([
        high - low,
        (high - prev_close).abs(),
        (low - prev_close).abs()
    ], axis=1).max(axis=1)
    min_p = min(period, max(20, len(df) - 2))
    return tr.rolling(window=period, min_periods=min_p).mean()

def compute_100d_slot_averages(df_1m_hist, today_date):
    df_prior = df_1m_hist[df_1m_hist.index.date < today_date].copy()
    if df_prior.empty:
        return None

    all_dates = sorted(list(set(df_prior.index.date)))
    last_100_dates = set(all_dates[-VOL_AVG_TRADING_DAYS:])
    df_100 = df_prior[pd.Series(df_prior.index.date, index=df_prior.index).isin(last_100_dates)]

    if df_100.empty:
        return None

    avg_3m = {}
    for label, start_t, end_t in SLOTS_3M:
        sub = df_100.between_time(start_t, end_t)
        daily_vols = sub.groupby(sub.index.date)["volume"].sum()
        avg_3m[label] = round(float(daily_vols.mean()), 2) if not daily_vols.empty else 0.0

    avg_30m = {}
    for label, start_t, end_t, _ in SLOTS_30M:
        sub = df_100.between_time(start_t, end_t)
        daily_vols = sub.groupby(sub.index.date)["volume"].sum()
        avg_30m[label] = round(float(daily_vols.mean()), 2) if not daily_vols.empty else 0.0

    return {"avg_3m": avg_3m, "avg_30m": avg_30m, "days_used": len(last_100_dates)}

def build_daily_harvest_cache(conn, ic, valid_symbols, now_ist):
    today_str = now_ist.strftime("%Y-%m-%d")
    today_date = now_ist.date()
    print(f"\n🌾 Building Daily Harvest List for {today_str} ({len(valid_symbols)} F&O stocks)...")

    start_daily = (now_ist - timedelta(days=CALENDAR_LOOKBACK_DAYS_DAILY)).replace(hour=9, minute=15, second=0)
    start_1m = (now_ist - timedelta(days=CALENDAR_LOOKBACK_DAYS_1M)).replace(hour=9, minute=15, second=0)

    harvested_stocks = {}

    for item in valid_symbols:
        symbol = item["underlying"]
        trd_sym = item["trading_symbol"]
        exch = item["exchange"]
        try:
            df_bars = fetch_df(conn, ic, exch, trd_sym, conn.TIMEFRAME_TYPE_DAY, start_daily, now_ist)
            if not df_bars.empty:
                df_bars = df_bars[df_bars.index.date < today_date]

            if len(df_bars) < 25:
                continue

            df_bars["atr"] = calculate_atr_sma(df_bars, ATR_PERIOD)
            df_bars["body"] = (df_bars["close"] - df_bars["open"]).abs()

            bar_m1 = df_bars.iloc[-1]  # -1 Daily bar
            bar_m2 = df_bars.iloc[-2]  # -2 Daily bar

            ref_atr = float(bar_m1["atr"])
            body_m1 = float(bar_m1["body"])

            if pd.isna(ref_atr) or ref_atr <= 0:
                continue

            # Condition 1: -1 close < -2 close
            # Condition 2: |Open - Close| body < 0.67 * ATR(100)
            if not (bar_m1["close"] < bar_m2["close"] and body_m1 < (BODY_ATR_MULT * ref_atr)):
                continue

            df_1m_full = fetch_df(conn, ic, exch, trd_sym, conn.TIMEFRAME_TYPE_MIN, start_1m, now_ist)
            slot_avgs = compute_100d_slot_averages(df_1m_full, today_date)
            if not slot_avgs:
                continue

            body_atr_ratio = round(ref_atr / body_m1, 2) if body_m1 > 0 else 999.0

            harvested_stocks[symbol] = {
                "stock": symbol,
                "trading_symbol": trd_sym,
                "m2_close": round(float(bar_m2["close"]), 2),
                "m1_close": round(float(bar_m1["close"]), 2),
                "m1_body": round(body_m1, 2),
                "atr100": round(ref_atr, 2),
                "body_atr_ratio": body_atr_ratio,
                "avg_3m": slot_avgs["avg_3m"],
                "avg_30m": slot_avgs["avg_30m"],
                "days_used": slot_avgs["days_used"]
            }
            print(f"  ✅ Harvested {symbol}: -1 Close ({bar_m1['close']:.2f}) < -2 Close ({bar_m2['close']:.2f}) | Body: {body_m1:.2f} < 0.67*ATR ({0.67*ref_atr:.2f}) | {slot_avgs['days_used']}d Vol Avg")

        except Exception as e:
            print(f"⚠️ Error harvesting {symbol}: {e}")

    cache_data = {
        "trade_date": today_str,
        "sent_slots": [],
        "stocks": harvested_stocks
    }
    with open(CACHE_FILE, "w", encoding="utf-8") as f:
        json.dump(cache_data, f, indent=2)

    print(f"🌾 Daily Harvest Complete: {len(harvested_stocks)} stock(s) shortlisted for today ({today_str}).")
    return cache_data

def load_or_build_today_cache(conn, ic, valid_symbols, now_ist):
    today_str = now_ist.strftime("%Y-%m-%d")
    if os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            if data.get("trade_date") == today_str and data.get("stocks"):
                return data
        except Exception:
            pass
    return build_daily_harvest_cache(conn, ic, valid_symbols, now_ist)

def save_today_cache(cache_data):
    with open(CACHE_FILE, "w", encoding="utf-8") as f:
        json.dump(cache_data, f, indent=2)

