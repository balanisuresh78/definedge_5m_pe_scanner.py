# 7. STAY-AWAKE CLOCK FOR VOLUME SCANNER (PRE-MARKET HARVEST + 09:30 + 30M SLOTS)
# ==============================================================================
VOL_CHECKPOINTS_IST = [
    dtime(9, 5, 0),    # Pre-market Daily Harvest + 100d Slot Baseline Pre-Calculation
    dtime(9, 30, 10),  # First Five 3-Minute Slots (09:15-09:30) Evaluation & Email
    dtime(10, 0, 10),  # 30m Slot 1 (09:30-10:00)
    dtime(10, 30, 10), # 30m Slot 2 (10:00-10:30)
    dtime(11, 0, 10),  # 30m Slot 3 (10:30-11:00)
    dtime(11, 30, 10), # 30m Slot 4 (11:00-11:30)
    dtime(12, 0, 10),  # 30m Slot 5 (11:30-12:00)
    dtime(12, 30, 10), # 30m Slot 6 (12:00-12:30)
    dtime(13, 0, 10),  # 30m Slot 7 (12:30-13:00)
    dtime(13, 30, 10), # 30m Slot 8 (13:00-13:30)
    dtime(14, 0, 10),  # 30m Slot 9 (13:30-14:00)
    dtime(14, 30, 10), # 30m Slot 10 (14:00-14:30)
    dtime(15, 0, 10),  # 30m Slot 11 (14:30-15:00)
    dtime(15, 30, 10), # 30m Slot 12 (15:00-15:30)
]

def stay_awake_volume_clock():
    session_mode = os.environ.get("SESSION_MODE", "MORNING")
    now_ist = datetime.now(IST)

    if now_ist.time() < dtime(5, 30) or now_ist.time() > dtime(15, 35):
        if session_mode == "MORNING":
            print("🚀 Outside market hours. Building/testing harvest cache once...")
            run_volume_scanner()
        return

    if session_mode == "MORNING":
        if now_ist.time() >= dtime(11, 35):
            return
        session_cutoff = dtime(11, 35)
    else:
        session_cutoff = dtime(15, 35)

    try:
        run_volume_scanner()
    except Exception as e:
        print(f"⚠️ Startup scan warning: {e}")

    while True:
        now_ist = datetime.now(IST)
        if now_ist.weekday() >= 5 or now_ist.time() >= session_cutoff:
            break

        today_date = now_ist.date()
        future_pts = [
            IST.localize(datetime.combine(today_date, cp))
            for cp in VOL_CHECKPOINTS_IST
            if cp > now_ist.time() and cp <= session_cutoff
        ]
        if not future_pts:
            break

        next_dt = future_pts[0]
        sleep_secs = (next_dt - now_ist).total_seconds()
        print(f"💤 Sleeping {round(sleep_secs / 60, 1)} min until {next_dt.strftime('%H:%M:%S IST')}...")
        time.sleep(max(1.0, sleep_secs))

        try:
            run_volume_scanner()
        except Exception as e:
            print(f"⚠️ Checkpoint scan error: {e}")

if __name__ == "__main__":
    stay_awake_volume_clock()
